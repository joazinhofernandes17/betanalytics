# ============================================================
# BetAnalytics — Variáveis de Ambiente
# Copia este ficheiro para .env.local e preenche os valores
# ============================================================

# Supabase — obtém em https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Groq — obtém em https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# The Odds API — obtém em https://the-odds-api.com (plano gratuito: 500 requests/mês)
# Opcional: se não configurado, a IA gera apostas com base no seu conhecimento (fallback)
ODDS_API_KEY=

# Segredo para proteger o cron job e endpoints admin
# Gera com: openssl rand -hex 32
CRON_SECRET=muda_este_valor_em_producao

# URL da aplicação (sem trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Emails de admin separados por vírgula (para acesso ao /admin)
ADMIN_EMAILS=admin@exemplo.com,outro@exemplo.com
